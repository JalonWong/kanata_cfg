#|
One defcfg entry may be added, which is used for configuration key-pairs. These
configurations change kanata's behaviour at a more global level than the other
configuration entries.
|#

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  log-layer-changes no
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet menu rctl
)

(defalias
  grl (tap-hold-press 200 300 _ (layer-while-held layers))
  ;; lsf (one-shot-press 200 lsft)
  rsf (tap-hold-press 200 300 (layer-switch functions) _)
  LF (layer-while-held functions)
  L1 (layer-switch default)
  L2 (layer-switch dvorak)

  dcl (multi (layer-while-held default) lctl)
)

(defchordsv2
  (7 8) . 150 first-release ()
)

(deflayer default
  _    _    _    _    _    _    _    _    _    _    _    _    _
  @grl 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    _    ]    \
  lctl a    s    d    f    g    h    j    k    l    ;    '    ret
  _    z    x    c    v    b    n    m    ,    .    /    @rsf
  caps lmet lalt           spc            ralt rmet @LF  rctl
)

(deflayer dvorak
  _    _    _    _    _    _    _    _    _    _    _    _    _
  @grl 1    2    3    4    5    6    7    8    9    0    [    ]    bspc
  tab  '    ,    .    p    y    f    g    c    r    l    /    =    \
  @dcl a    o    e    u    i    d    h    t    n    s    -    ret
  _    ;    q    j    k    x    b    m    w    v    z    rsft
  caps lmet lalt           spc            ralt rmet @LF  rctl
)

(deflayer functions
  _    mute vold volu _    pp   prev next _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    home up   end  pgup _    _    _
  lctl _    _    bspc del  _    _    left down rght pgdn _    _
  _    _    _    _    _    _    _    _    _    _    @L1  @L1
  _    _    _              _              _    _    _    _
)

(deflayer layers
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @L1  @L2  _    lrld _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _    _
)
